<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.ni.asignacion_evaluada.MenuController"
            onContextMenuRequested="#mostrarContextMenu">

    <top>

        <MenuBar>

            <!-- MENÚ CATÁLOGO -->
            <Menu text="Catálogo">

                <MenuItem text="Registro de Estudiantes"
                          onAction="#abrirEstudiantes"/>

                <MenuItem text="Registro de Películas"
                          onAction="#abrirPeliculas"/>

            </Menu>


            <!-- MENÚ DESARROLLADOR -->
            <Menu text="Desarrollador">

                <MenuItem text="Información del desarrollador"
                          onAction="#mostrarDesarrollador"/>

            </Menu>


            <!-- TERCER MENÚ -->
            <Menu text="Ayuda">

                <MenuItem text="Acerca de"
                          onAction="#mostrarAyuda"/>

            </Menu>

        </MenuBar>

    </top>


    <center>

        <VBox alignment="CENTER"
              spacing="15">

            <Label text="MENÚ PRINCIPAL"
                   style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

            <Label text="Sistema de Registro"
                   style="-fx-font-size: 18px;"/>

            <Label text="Haga clic derecho para mostrar el menú contextual"/>

        </VBox>

    </center>


    <fx:define>

        <ContextMenu fx:id="contextMenu">

            <items>

                <MenuItem text="Registro de Estudiantes"
                          onAction="#abrirEstudiantes"/>

                <MenuItem text="Registro de Películas"
                          onAction="#abrirPeliculas"/>

                <SeparatorMenuItem/>

                <MenuItem text="Información del desarrollador"
                          onAction="#mostrarDesarrollador"/>

            </items>

        </ContextMenu>

    </fx:define>

</BorderPane>