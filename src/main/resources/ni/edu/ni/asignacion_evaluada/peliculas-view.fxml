<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15"
      prefWidth="800"
      prefHeight="650"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.ni.asignacion_evaluada.PeliculasController">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label text="REGISTRO DE PELÍCULAS"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>


    <!-- TABLA -->

    <TableView fx:id="tablaPeliculas"
               prefHeight="300">

        <columns>

            <TableColumn fx:id="colTitulo"
                         text="Título"
                         prefWidth="150"/>

            <TableColumn fx:id="colDirector"
                         text="Director"
                         prefWidth="150"/>

            <TableColumn fx:id="colGenero"
                         text="Género"
                         prefWidth="120"/>

            <TableColumn fx:id="colAnio"
                         text="Año"
                         prefWidth="100"/>

            <TableColumn fx:id="colDuracion"
                         text="Duración"
                         prefWidth="120"/>

        </columns>

    </TableView>


    <!-- CAMPOS -->

    <TextField fx:id="txtTitulo"
               promptText="Título de la película"/>

    <TextField fx:id="txtDirector"
               promptText="Director"/>

    <TextField fx:id="txtGenero"
               promptText="Género"/>

    <TextField fx:id="txtAnio"
               promptText="Año"/>

    <TextField fx:id="txtDuracion"
               promptText="Duración en minutos"/>


    <!-- BOTONES -->

    <HBox spacing="10">

        <Button text="Limpiar"
                onAction="#limpiarCampos"/>

        <Button text="Procesar información"
                onAction="#procesarInformacion"/>

    </HBox>

</VBox>